{
    "name": "dawatkhi/api-version-platform",
    "description": "Self-contained API Version Platform UI and PHP backend, served locally via `vendor/bin/avp-serve`.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["openapi", "api", "versioning", "swagger", "ui"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "composer-runtime-api": "^2.2"
    },
    "suggest": {
        "ext-gd": "Required for avatar uploads (WebP conversion)",
        "ext-fileinfo": "Required for avatar upload MIME validation"
    },
    "autoload": {
        "psr-4": {
            "Dawatkhi\\ApiVersionPlatform\\": "src/"
        }
    },
    "bin": [
        "bin/avp-serve"
    ],
    "scripts": {
        "sync": "@php scripts/sync.php",
        "lint": "@php scripts/lint.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
