{
    "name": "mohammad-wq/api-version-platform",
    "description": "Local README-to-OpenAPI versioning for PHP projects.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.5",
    "keywords": ["openapi", "api", "versioning", "swagger", "ui"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "composer-runtime-api": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Mohammad\\ApiVersionPlatform\\": "src/"
        }
    },
    "bin": [
        "bin/avp",
        "bin/avp-serve"
    ],
    "scripts": {
        "sync": "@php scripts/sync.php",
        "lint": "@php scripts/lint.php",
        "test": "@php tests/parser_test.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
