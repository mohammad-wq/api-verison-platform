#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dawatkhi\ApiVersionPlatform\Config;
use Dawatkhi\ApiVersionPlatform\Server;

// Composer >= 2.2 bin proxies set $_composer_autoload_path; otherwise we're running from the package checkout.
$autoload = $_composer_autoload_path ?? null;
if ($autoload !== null && is_file($autoload)) {
    require $autoload;
    $projectRoot = dirname(realpath($autoload), 2);
} else {
    require __DIR__ . '/../src/Config.php';
    require __DIR__ . '/../src/Server.php';
    $projectRoot = getcwd();
}

$usage = <<<TXT
API Version Platform

Usage:
  avp-serve [--host=127.0.0.1] [--port=8080] [--config=path/to/avp.config.php]
  avp-serve init [--force]     Create avp.config.php in the project root
  avp-serve check              Validate configuration and the database connection

Config lookup: --config, then {$projectRoot}/avp.config.php, then AVP_* env vars.

TXT;

// getopt() stops at the first positional arg, so parse `command --key=value --flag` by hand.
$command = 'serve';
$options = [];
foreach (array_slice($argv, 1) as $arg) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $arg, $m)) {
        $options[$m[1]] = $m[2] ?? true;
    } elseif ($arg === '-h') {
        $options['help'] = true;
    } else {
        $command = $arg;
    }
}

if (isset($options['help'])) {
    fwrite(STDOUT, $usage);
    exit(0);
}

try {
    if ($command === 'init') {
        $path = Server::init($projectRoot, isset($options['force']));
        fwrite(STDOUT, "Created {$path}\nEdit the db section, then run: vendor/bin/avp-serve\n");
        fwrite(STDOUT, "Remember to add avp.config.php to your .gitignore.\n");
        exit(0);
    }

    $configFile = isset($options['config']) ? realpath($options['config']) ?: $options['config'] : Config::locate($projectRoot);
    $config = Config::load($configFile);

    $errors = Config::validate($config);
    if ($errors) {
        fwrite(STDERR, "Configuration problems:\n  - " . implode("\n  - ", $errors) . "\n");
        exit(1);
    }

    if ($command === 'check') {
        $db = $config['db'];
        $dsn = "mysql:host={$db['host']};port={$db['port']};dbname={$db['name']};charset={$db['charset']}";
        new PDO($dsn, $db['user'], $db['pass'], [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
        fwrite(STDOUT, "Config OK" . ($configFile ? " ({$configFile})" : ' (env/defaults)') . "\nDatabase connection OK\n");
        exit(0);
    }

    if ($command !== 'serve') {
        fwrite(STDERR, "Unknown command: {$command}\n\n{$usage}");
        exit(1);
    }

    $host = $options['host'] ?? $config['server']['host'];
    $port = (int) ($options['port'] ?? $config['server']['port']);

    fwrite(STDOUT, "API Version Platform running at http://{$host}:{$port}\n");
    fwrite(STDOUT, "Local development tool only - do not expose to the internet. Press Ctrl+C to stop.\n\n");

    exit(Server::run($host, $port, $configFile));
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}
